# Copy this file to .env.local for local development
# In Vercel, add these as Environment Variables in your project settings

# Existing chat proxy key
ANTHROPIC_API_KEY=your_api_key_here

# Supabase (client)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase (server/api)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe billing
STRIPE_SECRET_KEY=sk_live_or_test
STRIPE_WEBHOOK_SECRET=whsec_123
STRIPE_PRICE_ID=price_123
STRIPE_SUCCESS_URL=https://your-app-url/?billing=success
STRIPE_CANCEL_URL=https://your-app-url/?billing=cancel
STRIPE_PORTAL_RETURN_URL=https://your-app-url/account
APP_URL=https://your-app-url

# Optional Google Calendar OAuth and conflict checks
GOOGLE_CLIENT_ID=google_oauth_client_id
GOOGLE_REDIRECT_URI=https://your-app-url/oauth/google/callback

# Optional reminder dispatcher secret
REMINDER_DISPATCH_SECRET=random_secret
